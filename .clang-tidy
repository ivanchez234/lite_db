# Статический анализ. вспомогательный файл для CI чтобы отследить все возможные ошибки
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  cert-err33-c,
  cert-err58-cpp,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  performance-*,
  -performance-avoid-endl,
  -performance-enum-size


WarningsAsErrors: '*'

# Только свой код: заголовки Catch2 и системные не проверяем.
HeaderFilterRegex: '.*/(storage|database|server|Orm)/.*'
